# ==============================================================================
# FaceSense AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values according to your environment.
# Note: Do NOT commit actual secrets or credentials to source control.

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://facesense_user:facesense_password@localhost:5432/facesense_db

# Database Connection Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Optional API Settings
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEFAULT_CONFIDENCE_THRESHOLD=0.50

# Security Settings
# JWT_SECRET_KEY is REQUIRED. The application will refuse to start without it.
# Generate a secure random key with:  python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value to source control.
JWT_SECRET_KEY=replace-this-with-a-strong-random-secret
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload and Rate Limiting
# MAX_IMAGE_UPLOAD_MB=10
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PREDICT=30/minute
# RATE_LIMIT_FEEDBACK=60/minute
# RATE_LIMIT_AUTH=10/minute
